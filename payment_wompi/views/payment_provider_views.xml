<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_wompi" model="ir.ui.view">
        <field name="name">payment.provider.form.wompi</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group attrs="{'invisible': [('code', '!=', 'wompi')]}">
                    <label
                        string="Configure la clave pública y privada de Wompi en los campos estándar del proveedor."
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
