<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_wompi" model="ir.ui.view">
        <field name="name">payment.provider.form.wompi</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="credentials" position="inside">
                <group invisible="code != 'wompi'">
                    <field name="wompi_public_key" password="True"/>
                    <field name="wompi_private_key" password="True"/>
                    <field name="wompi_sandbox"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
